{
  "name": "shiori-markdown",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:desktop": "vite --mode desktop",
    "icons": "node scripts/generate-icons.mjs",
    "build:desktop": "tsc --noEmit && vite build --mode desktop",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --no-bundle",
    "desktop:check": "cargo check --locked --manifest-path src-tauri/Cargo.toml",
    "store:pack": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-msix.ps1",
    "store:bundle": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bundle-store.ps1",
    "store:assets": "node scripts/prepare-store-assets.mjs",
    "store:screenshots": "node scripts/capture-store-screenshots.mjs",
    "test:browser": "playwright test",
    "test:desktop": "playwright test --config playwright.desktop.config.ts",
    "test:portable": "playwright test --config playwright.portable.config.ts",
    "build": "tsc --noEmit && vite build",
    "build:portable": "tsc --noEmit && node --experimental-strip-types scripts/build-portable.mjs",
    "build:all": "node scripts/build-all.mjs",
    "release": "node scripts/build-all.mjs --release",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/reader.test.ts tests/editor.test.ts tests/workspace-state.test.ts tests/workspace-links.test.ts tests/workspace-removal.test.ts tests/security.test.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "@tauri-apps/plugin-opener": "2.7.2",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-code-block": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extension-paragraph": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "dompurify": "3.4.17",
    "highlight.js": "11.12.0",
    "markdown-it": "15.0.3",
    "markdown-it-task-lists": "2.1.1",
    "marked": "^17.0.6",
    "mdast-util-from-markdown": "2.0.3",
    "mermaid": "12.2.0",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/markdown-it": "14.2.0",
    "@types/node": "^24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0"
  }
}
